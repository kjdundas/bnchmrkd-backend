{
  "expo": {
    "name": "bnchmrkd.",
    "slug": "bnchmrkd",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141636"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bnchmrkd.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F3CF0"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.bnchmrkd.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "primaryColor": "#4F3CF0"
  }
}
